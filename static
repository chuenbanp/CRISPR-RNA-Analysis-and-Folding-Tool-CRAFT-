/* gRNA_WebApp/static/style.css */
body {
    font-family: sans-serif;
    margin: 2em;
    background-color: #f4f4f9;
}
h1, h2 {
    color: #333;
    text-align: center;
}
table {
    border-collapse: collapse;
    margin: 2em auto;
    width: 95%;
    box-shadow: 0 2px 15px rgba(0,0,0,0.1);
}
th, td {
    border: 1px solid #ccc;
    padding: 10px;
    text-align: center;
    vertical-align: middle;
}
th {
    background-color: #4CAF50;
    color: white;
}
tr:nth-child(even) {
    background-color: #f2f2f2;
}
img {
    border: 1px solid #eee;
    max-width: 250px;
    height: auto;
}
code {
    background-color: #e4e4e4;
    padding: 2px 5px;
    border-radius: 4px;
    font-family: 'Courier New', Courier, monospace;
}
.neutralhead { background-color: #7ab1d6 ; color: black;}
.goodhead { background-color: rgb(92, 195, 92); color: black}
.badhead {background-color: rgb(243, 141, 141); color: black;}
.good { background-color: #d4edda; color: #155724; }
.bad { background-color: #f8d7da; color: #721c24; }
.gc-high { background-color: #d4edda; }
code span { font-weight: bold; }

.container {
    background-color: white;
    padding: 2em;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    max-width: 800px;
    margin: 2em auto;
}

input[type="file"], input[type="submit"] {
    display: block;
    margin: 1em 0;
}
input[type="submit"] {
    background-color: #4CAF50;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1em;
}
input[type="submit"]:hover {
    background-color: #45a049;
}
.loader {
    border: 8px solid #f3f3f3;
    border-radius: 50%;
    border-top: 8px solid #3498db;
    width: 60px;
    height: 60px;
    animation: spin 2s linear infinite;
    margin: 20px auto;
    display: none; /* Hidden by default */
}
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
